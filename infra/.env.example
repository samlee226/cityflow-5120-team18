# Copy to infra/compose/.env on the host and set a generated password:
#   cp .env.example compose/.env
#   sed -i "s/CHANGE_ME/$(openssl rand -hex 24)/" compose/.env
#
# .env is gitignored. Never commit real credentials.
POSTGRES_DB=cityflow
POSTGRES_USER=cityflow_app
POSTGRES_PASSWORD=CHANGE_ME

# Connection string for the pipeline and the API. The database listens on
# loopback only, so this is localhost from the instance's point of view, and
# also from a workstation with the SSH tunnel open.
DATABASE_URL=postgresql://cityflow_app:CHANGE_ME@localhost:5432/cityflow
