# Copy this file to an untracked .env file and provide local values.
# Never commit database passwords, tokens or populated connection URLs.

# Preferred complete PostgreSQL connection URL for migrations and applications.
DATABASE_URL=

# Backward-compatible CityFlow-specific URL accepted by the migration runner.
CITYFLOW_DATABASE_URL=

# Alternatively use standard PostgreSQL variables instead of a URL.
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=

CITYFLOW_OPEN_DATA_BASE_URL=

# Live retention cleanup runs only after a successful non-dry-run ingestion.
CITYFLOW_LIVE_RETENTION_HOURS=24
CITYFLOW_LIVE_QUARANTINE_RETENTION_DAYS=7
CITYFLOW_LIVE_RUN_RETENTION_DAYS=30
