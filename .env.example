# Enable Maps JavaScript API, Places API, Geocoding API and Routes API.
# NEXT_PUBLIC_ values are inlined into the browser bundle, so this key must be
# restricted by HTTP referrer in the Google Cloud console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Base URL of the CityFlow API. Read only by the route handlers under app/api,
# which run on the server, so it is never exposed to the browser and may be a
# plain HTTP address.
CITYFLOW_API_BASE_URL=https://finer-conform-radiance.ngrok-free.dev
